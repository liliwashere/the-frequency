CF_PROJECT_NAME=the-frequency
CF_API_TOKEN=your_cloudflare_api_token

# Supabase (subscriber list + state storage)
SUPABASE_URL=https://mhociwppaqolnlnsynfu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service role key, not anon key

# Gmail OAuth2 (sending emails)
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_oauth_refresh_token
